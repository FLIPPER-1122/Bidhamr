# BidHamr – miljøvariabler (kun NAVNE og forklaringer, aldrig rigtige værdier).
#
# Lokalt: kopiér til .env.local (testdatabasen, npm run dev) eller
# .env.production.local (next build/start mod produktion). Begge er i .gitignore.
# Produktion: sættes i Vercel → Settings → Environment Variables (Filip selv).

# --- Supabase ---------------------------------------------------------------
# Projekt-URL. Test: https://pjiigmzqwlfepxnjdvug.supabase.co
#              Prod: https://lkifkrexeldimmghnsie.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Offentlig nøgle (sb_publishable_…). Supabase → Settings → API Keys →
# "Publishable and secret API keys". Må gerne være i browseren (RLS gælder).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Hemmelig nøgle (sb_secret_…), samme sted. Omgår RLS – KUN på serveren.
SUPABASE_SECRET_KEY=

# GAMLE nøgler (JWT, fanen "Legacy API keys"). Bruges kun, hvis de nye
# ovenfor ikke er sat (src/lib/supabase/noegler.ts). Fjernes, når de gamle
# nøgler er slået fra i Supabase.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Egne hemmeligheder (uafhængige af Supabases nøgler) ----------------------
# Lange tilfældige værdier (mindst 32 tegn), forskellige i test og prod. Lav en:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Mangler de, afledes de af SUPABASE_SERVICE_ROLE_KEY (som før), og der logges
# en advarsel i /admin/drift i produktion.
# HMAC-nøgle til den signerede rolle-cookie (src/lib/rolleCookie.ts). Skiftes
# den, skal staff bare vente på ét ekstra databaseopslag – ingen logges ud.
ROLLE_COOKIE_HEMMELIGHED=
# HMAC-nøgle til signerede DSA-links i mails (src/lib/dsa/link.ts). Skiftes
# den, holder alle udsendte DSA-links op med at virke.
DSA_LINK_HEMMELIGHED=

# --- Site og adgang -----------------------------------------------------------
# Sidens adresse (mails, metadata, sitemap). Standard https://bidhamr.dk
NEXT_PUBLIC_SITE_URL=
# "true" åbner tilmeldingen for alle (ellers kun staff før lancering).
TILMELDING_AABEN=
# Kun lokalt mod testdatabasen: "true" lukker siden som før lancering (gaten),
# så den kan testes. Virker ikke i produktion (dér er siden altid lukket).
SIMULER_FOER_LANCERING=
# "true" lader søgemaskiner indeksere siden (kun prod efter lancering).
SEO_INDEKSERING=
# Beskytter /api/cron/* (Authorization: Bearer <CRON_SECRET>). Samme værdi som
# Vault-hemmeligheden cron_secret i Supabase.
CRON_SECRET=
# VALGFRI: livstegn til en ekstern overvågning (fx healthchecks.io eller
# UptimeRobot "heartbeat"). Betalings-cron'en (hvert 5. minut) kalder adressen
# efter hver kørsel - "<adresse>" ved succes og "<adresse>/fail" ved fejl - så
# en tjeneste UDEN FOR Supabase/Vercel alarmerer, hvis livstegnet udebliver.
# Kun https. Ikke sat = intet livstegn (alt andet virker som før).
HEARTBEAT_URL=

# --- Stripe (kun testnøgler indtil fase 6) ------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Mail, push og drift ------------------------------------------------------
RESEND_API_KEY=
# Lokalt/test: send alle mails til denne ene adresse i stedet for modtageren.
MAIL_TEST_MODTAGER=
# Expo push (valgfri adgangstoken).
EXPO_ACCESS_TOKEN=
# Modtagere af driftalarmer, kommasepareret (højst 5).
DRIFT_ALARM_MAIL=
# Timeout for /api/helbred i ms (1-10000, standard 3000).
HELBRED_TIMEOUT_MS=

# --- Fragt --------------------------------------------------------------------
# Valgt fragtfirma (tom = ikke sat op).
FRAGTFIRMA=
# "true" viser fragtlabels på handelssiden.
FRAGT_LABELS_AKTIV=
# Webhook-hemmelighed til test-fragtfirmaet (mindst 16 tegn).
FRAGT_TEST_WEBHOOK_SECRET=

# "true" = køberen kan lave returlabel i en sag (kræver, at opkrævningen af
# returfragten er bygget - se docs/FRAGT.md).
FRAGT_RETURLABEL_AKTIV=
# Shipmondo (DAO). Sandbox: https://sandbox.shipmondo.com/api/public/v3
# Produktion: https://app.shipmondo.com/api/public/v3
SHIPMONDO_API_URL=
SHIPMONDO_API_BRUGER=
SHIPMONDO_API_NOEGLE=
# Nøglen, der indtastes, når webhooken oprettes hos Shipmondo (mindst 16 tegn).
SHIPMONDO_WEBHOOK_NOEGLE=
# "true" = book på BidHamrs egen DAO-aftale i Shipmondo (own_agreement).
SHIPMONDO_EGEN_AFTALE=

# --- Fakturaer i Dinero (docs/FAKTURA.md) --------------------------------------
# Personlig integration i Dinero (Integrationer -> API-nøgler). Kun server.
DINERO_CLIENT_ID=
DINERO_CLIENT_SECRET=
# API-nøglen for organisationen og organisationens id (kun tal).
DINERO_API_KEY=
DINERO_ORG_ID=
# test | live (standard test). Produktionsdatabasen kræver live; testdatabasen
# må aldrig bruge live.
DINERO_MILJOE=
# Kontonumre i Dineros kontoplan (standard 1000 / 1350 / 55000).
DINERO_KONTO_SALG=
DINERO_KONTO_FRAGT=
DINERO_KONTO_INDBETALING=
